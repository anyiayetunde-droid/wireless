<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Mode switch: Bluetooth keyboard vs WiFi remote -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="8dp">

        <Button
            android:id="@+id/btnModeBt"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/mode_bluetooth" />

        <Button
            android:id="@+id/btnModeWifi"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/mode_wifi" />
    </LinearLayout>

    <!-- Bluetooth HID keyboard mode -->
    <LinearLayout
        android:id="@+id/btPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_idle"
            android:textSize="15sp"
            android:textColor="#22d3ee"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_paired"
            android:textStyle="bold"
            android:paddingTop="4dp"
            android:paddingBottom="2dp" />

        <ListView
            android:id="@+id/listPaired"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:choiceMode="none" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnScan"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/btn_scan" />

            <Button
                android:id="@+id/btnDisconnect"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/btn_disconnect"
                android:enabled="false" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_found"
            android:textStyle="bold"
            android:paddingTop="4dp"
            android:paddingBottom="2dp" />

        <ListView
            android:id="@+id/listFound"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:choiceMode="none" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#31405e"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/keyboardHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

    <!-- WiFi remote mode: the laptop types into this phone -->
    <LinearLayout
        android:id="@+id/wifiPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvWifiStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wifi_status_idle"
            android:textSize="15sp"
            android:textColor="#22d3ee"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_wifi"
            android:textStyle="bold"
            android:paddingTop="4dp"
            android:paddingBottom="2dp" />

        <EditText
            android:id="@+id/etWifiHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/wifi_host_hint"
            android:inputType="textUri"
            android:singleLine="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etWifiPort"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="@string/wifi_port_hint"
                android:inputType="number"
                android:singleLine="true"
                android:text="8030" />

            <EditText
                android:id="@+id/etWifiPin"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="@string/wifi_pin_hint"
                android:inputType="numberPassword"
                android:singleLine="true" />
        </LinearLayout>

        <Button
            android:id="@+id/btnWifiConnect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_wifi_connect"
            android:paddingTop="10dp"
            android:paddingBottom="10dp" />

        <Button
            android:id="@+id/btnWifiSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_wifi_settings" />

        <Button
            android:id="@+id/btnWifiAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_wifi_accessibility" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wifi_hint"
            android:textSize="13sp"
            android:textColor="#aab4c3"
            android:paddingTop="10dp" />
    </LinearLayout>
</LinearLayout>